# Database output path
DB_PATH=output/asana_simulation.sqlite

# Organization scale (optional override)
MIN_USERS=5000
MAX_USERS=10000

MIN_TEAMS=20
MAX_TEAMS=40

# Task generation
MIN_TASKS_PER_PROJECT=30
MAX_TASKS_PER_PROJECT=150

UNASSIGNED_TASK_PROBABILITY=0.15

# Subtasks
SUBTASK_PROBABILITY=0.4
MAX_SUBTASKS_PER_TASK=6

# Comments
MAX_COMMENTS_PER_TASK=8

# NOTE:
# LLM usage is offline and cached.
# No API keys are required to run this project.
